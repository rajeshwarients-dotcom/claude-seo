{%- comment -%}
  Rajeshwari Tools — INGCO spare parts & exploded views hub.
  Data lives in Shopify Files: sp-index.json (model list), sp-parts.json (all parts), ev-*.webp (drawings).
  Deep links: ?model=AG900282  ·  ?q=carbon+brush  ·  ?cat=Drills+%26+Drivers
{%- endcomment -%}
{{ 'rt-spare-parts.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign idx_url = 'sp-index.json' | file_url
  assign parts_url = 'sp-parts.json' | file_url
  assign base = idx_url | split: 'sp-index.json' | first
  assign wa = settings.rt_whatsapp | remove: '+' | remove: ' ' | remove: '-'
-%}
<div
  class="rt-sp page-width section-{{ section.id }}-padding"
  id="rt-sp"
  data-index="{{ idx_url }}"
  data-parts="{{ parts_url }}"
  data-base="{{ base }}"
  data-wa="{{ wa }}"
  data-phone="{{ settings.rt_phone | remove: ' ' }}"
  data-page="{{ request.path }}"
>
  <header class="rt-sp__hero">
    <p class="rt-sp__kicker">{{ section.settings.kicker | escape }}</p>
    <h1 class="rt-sp__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="rt-sp__sub">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <form class="rt-sp__search" role="search" onsubmit="return false">
      <label class="visually-hidden" for="rt-sp-q">Search spare parts</label>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M10 2a8 8 0 0 1 6.3 12.9l5.4 5.4-1.4 1.4-5.4-5.4A8 8 0 1 1 10 2zm0 2a6 6 0 1 0 0 12 6 6 0 0 0 0-12z"/></svg>
      <input
        id="rt-sp-q"
        type="search"
        autocomplete="off"
        enterkeyhint="search"
        placeholder="Model (AG900282), part code (AG900282-SP-38) or part name"
      >
      <button type="button" class="rt-sp__clear" hidden aria-label="Clear search">&times;</button>
    </form>
    <p class="rt-sp__stats" data-stats>Loading parts catalogue&hellip;</p>
  </header>

  <nav class="rt-sp__cats" data-cats aria-label="Filter by tool category"></nav>

  <div data-list>
    <div class="rt-sp__parthits" data-parthits hidden></div>
    <div class="rt-sp__grid" data-grid></div>
    <p class="rt-sp__empty" data-empty hidden>
      No match. Try a shorter model code (e.g. <b>CDLI</b>) or send us your tool's photo on WhatsApp.
    </p>
  </div>

  <div class="rt-sp__model" data-model hidden></div>

  <div class="rt-sp__bar" data-bar hidden>
    <span data-bar-count></span>
    <button type="button" class="rt-sp__bar-clear" data-bar-clear>Clear</button>
    <a class="button rt-sp__bar-go" data-bar-go target="_blank" rel="noopener">Enquire on WhatsApp</a>
  </div>

  <noscript><p>Please enable JavaScript to browse spare parts, or WhatsApp us your tool model.</p></noscript>
</div>
<script src="{{ 'rt-spare-parts.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Spare parts hub",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "INGCO genuine spares" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spare parts & exploded views" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Find your tool by model number, open its exploded drawing, and pick parts by their number. Select several parts and send one enquiry on WhatsApp."
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "presets": [{ "name": "Spare parts hub" }]
}
{% endschema %}

{% style %}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
{% endstyle %}
